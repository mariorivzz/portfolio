# Formspree contact form
# Sign up at formspree.io → New Form → copy the URL (https://formspree.io/f/XXXXXXXX)
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Groq AI — chatbot backend (free tier is very generous)
# Get your key at: console.groq.com → API Keys
GROQ_API_KEY=gsk_your_key_here

# OpenAI (no longer used — kept for reference)
# OPENAI_API_KEY=sk-...

# OpenTelemetry export (optional — leave empty to use console output only)
# Supported: console | otlp
OTEL_EXPORTER=console

# OTLP endpoint — only needed if OTEL_EXPORTER=otlp
# Example: http://localhost:4318 (local Jaeger/OTLP collector)
# Example: https://ingest.us.signoz.cloud:443 (SigNoz cloud)
# Example: https://api.honeycomb.io (Honeycomb)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
