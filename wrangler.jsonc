{
	"compatibility_date": "2026-05-08",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "digital-disk",
	"main": "./dist/server/entry.mjs",
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": [
				"dist/server/**/*.mjs"
			]
		}
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
