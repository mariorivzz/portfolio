---
// Los planes viven en src/data/services.js (fuente única, también usada por el
// desplegable del formulario de contacto).
import { services, teaserValues } from '../data/services.js';

interface Props {
  /** true = resumen para la portada (3 planes + enlace a /servicios). */
  teaser?: boolean;
}

const { teaser = false } = Astro.props;

const list = teaser
  ? teaserValues.map(v => services.find(s => s.value === v)).filter(Boolean)
  : services;

// El formulario vive en la portada. Desde /servicios hay que volver a ella
// pasando el plan por la URL (?servicio=…), que Contact.astro ya sabe leer.
const isHome = Astro.url.pathname === '/';
const contactHref = (value) => (isHome ? '#contact' : `/?servicio=${value}#contact`);
---

<section id="services" class="services">
  <div class="container">

    <div class="services__header reveal-up">
      <span class="section-tag">De la página más sencilla al mantenimiento mensual</span>
      <h2 class="services__heading">
        Soluciones web diseñadas<br />
        <em>para tu negocio local</em>
      </h2>
      <p class="services__subhead reveal-up">
        Sin tecnicismos. Sin complicaciones. Solo resultados reales para tu negocio.
        Trabajo solo y de forma directa: hablas siempre conmigo, no con un comercial.
      </p>
    </div>

    <div class="services__grid">
      {list.map(s => (
        <div class={`service-card reveal-up ${s.featured ? 'service-card--featured' : ''}`}>
          {s.featured && <span class="service-card__badge">Más recomendado</span>}

          <div class="service-card__head">
            <span class="service-card__icon" set:html={s.icon} />
            <span class="service-card__label">{s.label}</span>
          </div>

          <h3 class="service-card__title">{s.title}</h3>
          <p class="service-card__tagline">{s.tagline}</p>
          <p class="service-card__desc">{s.description}</p>

          <ul class="service-card__features">
            {s.features.map(f => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <p class="service-card__result">{s.result}</p>

          <div class="service-card__footer">
            <span class="service-card__price">{s.price}</span>
            <a href={contactHref(s.value)} class="btn btn-primary service-card__cta" data-prefill={s.value}>
              {s.cta}
            </a>
          </div>
        </div>
      ))}
    </div>

    {teaser && (
      <!-- Portada: solo un adelanto. El listado completo está en /servicios. -->
      <div class="services__more reveal-up">
        <p class="services__more-text">
          Hay {services.length} servicios en total, desde una página sencilla hasta
          el mantenimiento mes a mes, cada uno con su precio a la vista.
        </p>
        <a href="/servicios" class="btn btn-primary services__more-cta">
          <span>Ver todos los servicios y precios</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    )}

    {!teaser && (
      <!-- ¿Web antigua? — sin precio de catálogo: el alcance real depende de
           cómo esté montada la web actual del cliente, así que se habla primero. -->
      <div class="services__renew reveal-up">
        <div class="services__renew-copy">
          <span class="services__renew-tag">¿Y si ya tengo una web, pero antigua?</span>
          <h3 class="services__renew-title">
            ¿Tienes una web antigua y quieres renovarla?
          </h3>
          <p class="services__renew-text">
            Cada web vieja es un mundo, así que prefiero no darte un precio de catálogo
            que luego no encaje. Hablemos primero, sin compromiso, y vemos juntos qué
            necesita tu caso y qué merece la pena hacer.
          </p>
        </div>
        <a href={contactHref('renovar')} class="btn btn-primary services__renew-cta" data-prefill="renovar">
          <span>Hablemos de tu caso</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    )}

    <!-- Social proof / trust bar -->
    <div class="services__trust-bar reveal-up">
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Sin contratos de permanencia
      </div>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        Comunicación directa — sin intermediarios
      </div>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Respuesta en menos de 24 horas
      </div>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Presupuesto gratis y sin compromiso
      </div>
    </div>

  </div>
</section>

<style>
  .services {
    padding: var(--section-py) 0;
    border-top: 1px solid var(--border);
  }

  .services__header {
    margin-bottom: var(--space-6);
    max-width: 46rem;
  }

  .services__heading {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-2);
  }

  /* El énfasis va en color de marca, no con texto hueco de contorno:
     el contorno se lee mal y no cumple contraste. */
  .services__heading em {
    font-style: normal;
    color: var(--brand);
  }

  .services__subhead {
    font-size: var(--fs-lead);
    color: var(--text-2);
    max-width: 38rem;
    line-height: 1.7;
  }

  /* ── Cuadrícula — 3 + 3 tarjetas, la 7ª centrada debajo ───────
     Sin `align-items`, para que todas las tarjetas de una fila
     tengan exactamente el mismo alto. */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .services__grid > .service-card              { grid-column: span 2; }
  .services__grid > .service-card:nth-child(7) { grid-column: 3 / 5; }

  /* ── Tarjeta ─────────────────────────────────── */
  .service-card {
    position: relative;
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .service-card:hover {
    border-color: var(--brand-line);
    box-shadow: var(--shadow-md);
  }

  /* El plan recomendado se distingue por el borde y la etiqueta, no por
     otro color ni por desalinearse del resto de la cuadrícula. */
  .service-card--featured {
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
  }

  .service-card__badge {
    position: absolute;
    top: 0;
    right: var(--space-3);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-contrast);
    background: var(--brand);
    padding: 0.3125rem var(--space-2);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  /* ── Cabecera: icono + etiqueta ───────────────── */
  .service-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .service-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: var(--brand-soft);
    color: var(--brand);
    flex-shrink: 0;
  }

  .service-card__icon :global(svg) { width: 20px; height: 20px; }

  .service-card__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ── Cuerpo ───────────────────────────────────── */
  .service-card__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.25;
    margin-top: var(--space-1);
  }

  .service-card__tagline {
    font-size: var(--fs-sm);
    color: var(--brand);
    font-weight: 600;
    line-height: 1.5;
    margin-top: calc(var(--space-1) * -1);
  }

  .service-card__desc {
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.7;
  }

  .service-card__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px solid var(--border);
    flex: 1;
  }

  .service-card__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
    font-size: var(--fs-xs);
    color: var(--text-2);
    line-height: 1.55;
  }

  .service-card__features li svg {
    color: var(--support);
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* Frase de cierre: se mantiene, pero en discreto para que no compita
     con el precio ni con el botón. */
  .service-card__result {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Pie: precio + un único botón, siempre a la misma altura ─── */
  .service-card__footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .service-card__price {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .service-card__cta { width: 100%; }

  /* ── Portada: enlace al listado completo ─────── */
  .services__more,
  .services__renew {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-3);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .services__more-text {
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 34rem;
  }

  .services__more-cta,
  .services__renew-cta { flex-shrink: 0; }

  /* ── Bloque "renovar web antigua" ────────────── */
  .services__renew { border-style: dashed; border-color: var(--brand-line); }

  .services__renew-copy { max-width: 38rem; }

  .services__renew-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: var(--space-1);
  }

  .services__renew-title {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-1);
  }

  .services__renew-text {
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.7;
  }

  /* ── Barra de confianza ───────────────────────── */
  .services__trust-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--fs-xs);
    color: var(--text-2);
    white-space: nowrap;
  }

  .trust-item svg { color: var(--support); flex-shrink: 0; }

  @media (max-width: 1024px) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
    .services__grid > .service-card              { grid-column: span 1; }
    .services__grid > .service-card:nth-child(7) { grid-column: span 1; }
  }

  @media (max-width: 768px) {
    .services__more,
    .services__renew {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-3);
    }
    .services__more-cta,
    .services__renew-cta { width: 100%; }
  }

  @media (max-width: 640px) {
    .services__grid { grid-template-columns: 1fr; max-width: 32rem; margin-inline: auto; }
    .trust-item { white-space: normal; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('#services .reveal-up').forEach((el, i) => {
    gsap.to(el, {
      y: 0, opacity: 1, duration: 0.85, ease: 'power3.out',
      delay: i * 0.08,
      scrollTrigger: { trigger: el, start: 'top 88%', once: true },
    });
  });
</script>
