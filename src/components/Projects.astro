---
const projects = [
  {
    id: 1,
    category: 'Landing Page · Booking System',
    title: 'VetCare — Clínica Veterinaria',
    description:
      'Landing page profesional con sistema de reserva de citas, diseño responsive y CTA optimizados para conversión. Resultado: +40% incremento en citas online.',
    tags: ['PHP', 'JavaScript', 'SCSS', 'MySQL'],
    url: 'https://veterinario-sedano.vercel.app/',
    gradient: 'linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 60%, #0f4c75 100%)',
    accent: '#00d4ff',
  },
  {
    id: 2,
    category: 'E-Commerce Platform',
    title: 'TiendaMax — Plataforma de Ventas',
    description:
      'Tienda online completa con panel de administración, gestión de inventario, pasarela de pago integrada y módulo de analítica de ventas en tiempo real.',
    tags: ['PHP', 'MySQL', 'JavaScript', 'SCSS'],
    url: '#',
    gradient: 'linear-gradient(135deg, #0a1628 0%, #1a3a2a 60%, #0d3320 100%)',
    accent: '#00ff87',
  },
  {
    id: 3,
    category: 'Corporate Site + CMS',
    title: 'Constructora Ibérica — Portal Corporativo',
    description:
      'Sitio web corporativo con CMS a medida, blog integrado, formularios de captación de leads y panel multiusuario para el equipo de marketing.',
    tags: ['PHP', 'JavaScript', 'MySQL', 'SCSS'],
    url: '#',
    gradient: 'linear-gradient(135deg, #1a0a28 0%, #3a1a5c 60%, #4c0f75 100%)',
    accent: '#b06aff',
  },
  {
    id: 4,
    category: 'SaaS Dashboard',
    title: 'FlowDesk — Gestión de Equipos',
    description:
      'Aplicación web de gestión de proyectos con autenticación JWT, roles de usuario, paneles de analítica y sistema de notificaciones en tiempo real.',
    tags: ['JavaScript', 'PHP', 'MySQL', 'REST API'],
    url: '#',
    gradient: 'linear-gradient(135deg, #1a0e0a 0%, #3a2010 60%, #5c3015 100%)',
    accent: '#ff6b35',
  },
];
---

<section id="projects" class="projects">
  <div class="container">
    <div class="projects__header reveal-up">
      <span class="section-tag">Portfolio</span>
      <h2 class="projects__heading">SELECTED WORK</h2>
      <p class="projects__sub">Proyectos reales, resultados medibles.</p>
    </div>

    <div class="projects__grid">
      {projects.map((p, i) => (
        <article
          class={`project-card project-card--${p.id} reveal-up`}
          data-index={i}
          style={`--card-accent: ${p.accent};`}
        >
          <!-- Visual area -->
          <div class="project-card__visual" style={`background: ${p.gradient};`}>
            <!-- Browser mockup bar -->
            <div class="project-card__browser">
              <span></span><span></span><span></span>
            </div>
            <!-- Overlay on hover -->
            <div class="project-card__overlay">
              <a
                href={p.url}
                target={p.url === '#' ? '_self' : '_blank'}
                rel="noopener noreferrer"
                class="project-card__link"
              >
                Ver proyecto
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M7 7h10v10"/></svg>
              </a>
            </div>
          </div>

          <!-- Info -->
          <div class="project-card__info">
            <p class="project-card__cat">{p.category}</p>
            <h3 class="project-card__title">{p.title}</h3>
            <p class="project-card__desc">{p.description}</p>
            <div class="project-card__tags">
              {p.tags.map(t => <span class="project-tag">{t}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding: var(--section-py) 0;
    border-top: 1px solid var(--border);
  }

  .projects__header {
    margin-bottom: 4rem;
  }

  .projects__heading {
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .projects__sub {
    color: var(--text-muted);
    font-size: 1rem;
  }

  /* ── Grid ─────────────────────────────────── */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  /* ── Card ─────────────────────────────────── */
  .project-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-card);
    transition: border-color 0.4s, transform 0.4s var(--ease-out-expo),
                box-shadow 0.4s;
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--card-accent, var(--border-accent));
    transform: translateY(-6px);
    box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 0 0 1px var(--card-accent, var(--border-accent));
  }

  /* Visual */
  .project-card__visual {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .project-card__browser {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 5px;
  }

  .project-card__browser span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
  }

  .project-card__browser span:nth-child(1) { background: #ff5f57; }
  .project-card__browser span:nth-child(2) { background: #ffbd2e; }
  .project-card__browser span:nth-child(3) { background: #27c93f; }

  .project-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.35s;
    backdrop-filter: blur(4px);
  }

  .project-card:hover .project-card__overlay { opacity: 1; }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 0.6rem 1.4rem;
    border-radius: 4px;
    transition: background 0.3s, border-color 0.3s;
  }

  .project-card__link:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.6);
  }

  /* Info */
  .project-card__info {
    padding: 1.5rem;
  }

  .project-card__cat {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--card-accent, var(--accent));
    margin-bottom: 0.5rem;
  }

  .project-card__title {
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.25;
  }

  .project-card__desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-muted);
    background: rgba(255,255,255,0.02);
  }

  /* ── 3-D tilt (JS-driven, no transforms needed here) ──── */

  @media (max-width: 768px) {
    .projects__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Scroll reveals ───────────────────────────────────────────
  gsap.utils.toArray<HTMLElement>('#projects .reveal-up').forEach((el, i) => {
    gsap.from(el, {
      y: 50, opacity: 0, duration: 0.85, ease: 'power3.out',
      delay: i === 0 ? 0 : 0,
      scrollTrigger: { trigger: el, start: 'top 88%', once: true },
    });
  });

  // ── 3-D card tilt on hover ───────────────────────────────────
  document.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width  - 0.5;
      const y = (e.clientY - rect.top)  / rect.height - 0.5;
      gsap.to(card, {
        rotateY: x * 8,
        rotateX: -y * 8,
        transformPerspective: 800,
        duration: 0.4,
        ease: 'power2.out',
      });
    });

    card.addEventListener('mouseleave', () => {
      gsap.to(card, { rotateY: 0, rotateX: 0, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
    });
  });
</script>
