<!-- Asistente virtual — habla con el endpoint /api/chat.
     El texto de cara al público evita tecnicismos a propósito: el visitante
     no necesita saber qué modelo hay detrás, solo que le van a contestar. -->

<div id="chat-widget" class="chat-widget" role="complementary" aria-label="Chat con el asistente virtual">
  <!-- Chat toggle button -->
  <button id="chat-toggle" class="chat-toggle" aria-label="Abrir chat" aria-expanded="false">
    <svg class="chat-toggle__icon chat-toggle__icon--open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    <svg class="chat-toggle__icon chat-toggle__icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span class="chat-toggle__badge" id="chat-badge">1</span>
  </button>

  <!-- Chat panel -->
  <div id="chat-panel" class="chat-panel" aria-hidden="true">
    <!-- Header -->
    <div class="chat-header">
      <div class="chat-header__avatar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      </div>
      <div class="chat-header__info">
        <span class="chat-header__name">Asistente virtual</span>
        <span class="chat-header__status" id="chat-status">
          <span class="chat-header__dot"></span>
          <span id="chat-status-text">En línea</span>
        </span>
      </div>
      <button id="chat-close" class="chat-header__close" aria-label="Cerrar chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Messages -->
    <div id="chat-messages" class="chat-messages" role="log" aria-live="polite">
      <!-- Initial bot message injected by JS -->
    </div>

    <!-- Quick actions -->
    <div class="chat-quick" id="chat-quick" role="list">
      <button class="chat-chip" data-q="¿Qué servicios ofreces?" role="listitem">Servicios</button>
      <button class="chat-chip" data-q="¿Cuánto cuesta una web?" role="listitem">Precios</button>
      <button class="chat-chip" data-q="¿Tienes disponibilidad ahora?" role="listitem">Disponibilidad</button>
    </div>

    <!-- Input -->
    <form id="chat-form" class="chat-input-wrap" autocomplete="off" novalidate>
      <input
        id="chat-input"
        type="text"
        placeholder="Escribe tu pregunta..."
        class="chat-input"
        maxlength="300"
        aria-label="Mensaje"
      />
      <button type="submit" class="chat-send" aria-label="Enviar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>
</div>

<style>
  /* ── Botón flotante ────────────────────────────────── */
  .chat-widget {
    position: fixed;
    bottom: var(--space-4);
    right: var(--space-4);
    z-index: 5000;
  }

  .chat-toggle {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: var(--brand);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-contrast);
    box-shadow: var(--shadow-lg);
    transition: background-color 0.2s var(--ease), transform 0.2s var(--ease),
                box-shadow 0.2s var(--ease);
  }

  .chat-toggle:hover {
    background: var(--brand-hover);
    transform: translateY(-2px);
  }

  .chat-toggle__icon { position: absolute; transition: opacity 0.2s, transform 0.2s; }
  .chat-toggle__icon--close { opacity: 0; transform: rotate(-90deg); }

  .chat-toggle.open .chat-toggle__icon--open  { opacity: 0; transform: rotate(90deg); }
  .chat-toggle.open .chat-toggle__icon--close { opacity: 1; transform: rotate(0deg); }

  .chat-toggle__badge {
    position: absolute;
    top: 0;
    right: 0;
    width: 1.125rem;
    height: 1.125rem;
    background: var(--support);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--bg);
    transition: opacity 0.2s;
  }

  /* ── Panel ─────────────────────────────────────────── */
  .chat-panel {
    position: absolute;
    bottom: 4.25rem;
    right: 0;
    width: min(23rem, 92vw);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    transform: translateY(12px) scale(0.98);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s var(--ease-out), opacity 0.25s var(--ease);
    transform-origin: bottom right;
    max-height: 80vh;
  }

  .chat-panel.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Cabecera */
  .chat-header {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
    flex-shrink: 0;
  }

  .chat-header__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background: var(--brand-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand);
    flex-shrink: 0;
  }

  .chat-header__name {
    display: block;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--text);
  }

  .chat-header__status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  .chat-header__dot {
    width: 6px;
    height: 6px;
    background: var(--support);
    border-radius: var(--radius-pill);
  }

  /* Asistente sin configurar o con la clave caducada */
  .chat-header__status.is-offline .chat-header__dot { background: var(--text-muted); }

  .chat-header__close {
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-header__close:hover { color: var(--text); background: var(--border); }

  /* Mensajes */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    scrollbar-width: thin;
    min-height: 15rem;
    max-height: 21rem;
  }

  .chat-msg {
    display: flex;
    gap: var(--space-1);
    max-width: 88%;
    animation: msg-in 0.25s var(--ease-out);
  }

  @keyframes msg-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .chat-msg--user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .chat-msg__bubble {
    padding: 0.625rem var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    line-height: 1.6;
    word-break: break-word;
  }

  .chat-msg--bot .chat-msg__bubble {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-2);
  }

  .chat-msg--user .chat-msg__bubble {
    background: var(--brand);
    color: var(--brand-contrast);
    font-weight: 500;
  }

  /* Indicador de "escribiendo" */
  .chat-typing {
    display: flex;
    gap: 4px;
    padding: 0.625rem var(--space-2);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .chat-typing span {
    width: 6px;
    height: 6px;
    background: var(--text-muted);
    border-radius: var(--radius-pill);
    animation: typing-dot 1.4s ease-in-out infinite;
  }

  .chat-typing span:nth-child(2) { animation-delay: 0.2s; }
  .chat-typing span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typing-dot {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  /* Atajos */
  .chat-quick {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }

  .chat-chip {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--brand);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease);
    white-space: nowrap;
  }

  .chat-chip:hover {
    background: var(--brand-soft);
    border-color: var(--brand);
  }

  /* Campo de escritura */
  .chat-input-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2);
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }

  .chat-input {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    padding: 0.5625rem 0.75rem;
    outline: none;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .chat-input::placeholder { color: var(--text-muted); }
  .chat-input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  .chat-send {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--brand);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-contrast);
    transition: background-color 0.2s var(--ease);
    flex-shrink: 0;
  }

  .chat-send:hover { background: var(--brand-hover); }

  @media (max-width: 480px) {
    .chat-widget { bottom: var(--space-2); right: var(--space-2); }
    .chat-panel { width: calc(100vw - var(--space-4)); right: calc(var(--space-2) * -1); }
  }
</style>

<script>
  // ── Conversation history (sent to /api/chat each turn) ───────
  const history: { role: 'user' | 'assistant'; content: string }[] = [];

  // ── Local fallback KB (used when API is unavailable) ─────────
  const FALLBACK = `Disculpa, el asistente no está disponible en este momento. Escríbeme directamente desde la sección de contacto o por WhatsApp. ¡Estaré encantado de ayudarte!`;

  // ── Typewriter effect ─────────────────────────────────────────
  function sleep(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  async function typeText(el: HTMLElement, text: string) {
    const formatted = text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br/>');
    el.innerHTML = '';
    let html = '';
    const nodes = formatted.split(/(<[^>]+>)/g);
    for (const node of nodes) {
      if (node.startsWith('<')) {
        html += node;
        el.innerHTML = html + '▋';
      } else {
        for (const char of node) {
          html += char;
          el.innerHTML = html + '▋';
          await sleep(12 + Math.random() * 18);
        }
      }
    }
    el.innerHTML = html;
  }

  // ── DOM refs ──────────────────────────────────────────────────
  const toggle   = document.getElementById('chat-toggle')!;
  const panel    = document.getElementById('chat-panel')!;
  const closeBtn = document.getElementById('chat-close')!;
  const messages = document.getElementById('chat-messages')!;
  const form     = document.getElementById('chat-form')!;
  const input    = document.getElementById('chat-input') as HTMLInputElement;
  const badge    = document.getElementById('chat-badge')!;
  const quick    = document.getElementById('chat-quick')!;

  let isOpen   = false;
  let isTyping = false;

  // El indicador no debe decir "En línea" si el asistente no puede responder:
  // prometer disponibilidad y fallar da peor impresión que avisar de entrada.
  function marcarNoDisponible() {
    const estado = document.getElementById('chat-status');
    const texto  = document.getElementById('chat-status-text');
    if (texto)  texto.textContent = 'No disponible ahora';
    if (estado) estado.classList.add('is-offline');
    // Los atajos llevan a preguntas que nadie va a contestar.
    quick.style.display = 'none';
  }

  function openChat() {
    isOpen = true;
    toggle.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
    panel.classList.add('open');
    panel.setAttribute('aria-hidden', 'false');
    badge.style.opacity = '0';
  }

  function closeChat() {
    isOpen = false;
    toggle.classList.remove('open');
    toggle.setAttribute('aria-expanded', 'false');
    panel.classList.remove('open');
    panel.setAttribute('aria-hidden', 'true');
  }

  toggle.addEventListener('click', () => isOpen ? closeChat() : openChat());
  closeBtn.addEventListener('click', closeChat);

  // ── Add message ───────────────────────────────────────────────
  function addMessage(text: string, role: 'bot' | 'user') {
    const msg    = document.createElement('div');
    msg.className = `chat-msg chat-msg--${role}`;
    const bubble  = document.createElement('div');
    bubble.className = 'chat-msg__bubble';
    bubble.textContent = text;
    msg.appendChild(bubble);
    messages.appendChild(msg);
    messages.scrollTop = messages.scrollHeight;
    return bubble;
  }

  function addTyping() {
    const msg = document.createElement('div');
    msg.className = 'chat-msg chat-msg--bot';
    msg.id = 'chat-typing-msg';
    msg.innerHTML = `<div class="chat-typing"><span></span><span></span><span></span></div>`;
    messages.appendChild(msg);
    messages.scrollTop = messages.scrollHeight;
  }

  function removeTyping() {
    document.getElementById('chat-typing-msg')?.remove();
  }

  // ── Call /api/chat ─────────────────────────────────────────────
  async function callAPI(_userText: string): Promise<string> {
    // 15-second timeout — prevents hanging fetch on slow/dead server
    const controller = new AbortController();
    const timeoutId  = setTimeout(() => controller.abort(), 15_000);

    let res: Response;
    try {
      res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
        signal: controller.signal,
      });
    } finally {
      clearTimeout(timeoutId);
    }

    // 401/403 (clave inválida) y 503 (sin configurar) son fallos permanentes:
    // insistir no sirve de nada, así que se marca el asistente como no
    // disponible y se ofrece un camino que sí funciona.
    if (res.status === 401 || res.status === 403 || res.status === 503) {
      marcarNoDisponible();
      return 'El asistente no está disponible en este momento. Escríbeme directamente por el formulario de contacto o por WhatsApp y te respondo yo en persona.';
    }
    // 504 sí es temporal: aquí reintentar tiene sentido.
    if (res.status === 504) {
      return 'El servidor está tardando en responder. Inténtalo de nuevo en unos segundos o contáctame directamente.';
    }
    if (!res.ok) {
      throw new Error(`HTTP ${res.status}`);
    }

    const data = await res.json();
    return (data.reply as string) ?? FALLBACK;
  }

  // ── Send & respond ─────────────────────────────────────────────
  async function handleSend(userText: string) {
    if (!userText.trim() || isTyping) return;
    isTyping = true;

    quick.style.display = 'none';

    // Push user turn to history before showing in UI
    history.push({ role: 'user', content: userText.trim() });
    addMessage(userText.trim(), 'user');

    addTyping();

    let reply = FALLBACK;
    try {
      reply = await callAPI(userText);
    } catch (err: unknown) {
      if ((err as { name?: string })?.name === 'AbortError') {
        reply = 'La solicitud tardó demasiado. Por favor, inténtalo de nuevo.';
      } else {
        console.warn('[ChatWidget] API error, using fallback.', err?.message ?? err);
      }
    }

    removeTyping();

    // Push assistant reply to history
    history.push({ role: 'assistant', content: reply });

    const botBubble = addMessage('', 'bot');
    await typeText(botBubble, reply);

    isTyping = false;
  }

  // ── Form submit ────────────────────────────────────────────────
  (form as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    await handleSend(text);
  });

  // ── Quick chips ────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.chat-chip').forEach(chip => {
    chip.addEventListener('click', () => handleSend(chip.dataset.q!));
  });

  // ── Initial greeting (local, no API cost) ─────────────────────
  const GREETING = `¡Hola! 👋 Soy el asistente virtual de Mario. Puedo resolverte dudas sobre los servicios, los precios y cómo trabajamos. Pregúntame con toda confianza, ¿en qué puedo ayudarte?`;
  setTimeout(() => {
    const greeting = addMessage('', 'bot');
    typeText(greeting, GREETING);
  }, 200);
</script>
