---
// "Sobre mí" y "Contacto" son secciones de la portada; Servicios y Proyectos
// tienen página propia. El prefijo "/" hace que funcionen también desde ellas.
const links = [
  { href: '/#about',    label: 'Sobre mí'  },
  { href: '/servicios', label: 'Servicios' },
  // Sección Proyectos: pendiente de añadir casos reales, reactivar cuando tenga
  // proyectos aprobados por el cliente para mostrar.
  // { href: '/proyectos', label: 'Proyectos' },
  { href: '/#contact',  label: 'Contacto'  },
];
---

<nav id="nav" class="nav">
  <div class="container nav__inner">
    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="Inicio">
      <span class="nav__logo-symbol">&lt;</span>dev<span class="nav__logo-symbol">/&gt;</span>
    </a>

    <!-- Desktop links -->
    <ul class="nav__links" role="list">
      {links.map(l => (
        <li>
          <a href={l.href} class="nav__link">{l.label}</a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button class="nav__burger" id="nav-burger" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
    <ul role="list">
      {links.map(l => (
        <li><a href={l.href} class="nav__mobile-link">{l.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: var(--space-3) 0;
    transition: padding 0.3s var(--ease), background-color 0.3s var(--ease),
                border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .nav.scrolled {
    padding: var(--space-2) 0;
    background: rgba(250, 249, 246, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* Marca — misma tipografía y color en cabecera y pie */
  .nav__logo {
    font-family: var(--font-head);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: color 0.2s var(--ease);
    flex-shrink: 0;
  }
  .nav__logo-symbol { color: var(--brand); font-weight: 600; }
  .nav__logo:hover { color: var(--brand); }

  /* Enlaces */
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin-left: auto;
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-2);
    position: relative;
    padding: var(--space-1) 0;
    transition: color 0.2s var(--ease);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--brand);
    transition: width 0.3s var(--ease-out);
  }

  .nav__link:hover { color: var(--brand); }
  .nav__link:hover::after { width: 100%; }

  /* Botón de menú en móvil */
  .nav__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
    padding: var(--space-1);
  }

  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--text);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
    transform-origin: center;
  }

  .nav__burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__burger.open span:nth-child(2) { opacity: 0; }
  .nav__burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Menú desplegable en móvil */
  .nav__mobile {
    display: none;
    padding: var(--space-2) var(--pad-x) var(--space-3);
    margin-top: var(--space-2);
    border-top: 1px solid var(--border);
    background: var(--bg);
    box-shadow: var(--shadow-md);
  }

  .nav__mobile ul { list-style: none; display: flex; flex-direction: column; }

  .nav__mobile-link {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s var(--ease);
  }

  .nav__mobile-link:last-child { border-bottom: none; }
  .nav__mobile-link:hover { color: var(--brand); }

  @media (max-width: 768px) {
    .nav__links { display: none; }
    .nav__burger { display: flex; }
    .nav__mobile { display: block; }
    .nav__mobile[aria-hidden="true"] { display: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  const nav    = document.getElementById('nav')!;
  const burger = document.getElementById('nav-burger')!;
  const mobile = document.getElementById('nav-mobile')!;

  // ── Scroll handler ──────────────────────────────────────────
  const onScroll = () => {
    nav.classList.toggle('scrolled', window.scrollY > 60);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Mobile menu toggle ──────────────────────────────────────
  burger.addEventListener('click', () => {
    const isOpen = burger.classList.toggle('open');
    burger.setAttribute('aria-expanded', isOpen.toString());
    mobile.setAttribute('aria-hidden', (!isOpen).toString());
  });

  // ── Close on link click ─────────────────────────────────────
  mobile.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      burger.classList.remove('open');
      burger.setAttribute('aria-expanded', 'false');
      mobile.setAttribute('aria-hidden', 'true');
    });
  });

  // ── Entrance animation ──────────────────────────────────────
  function initNav() {
    gsap.from('.nav__inner', {
      y: -30, opacity: 0, duration: 0.9,
      ease: 'power4.out', delay: 0.1,
    });
  }
  document.body.addEventListener('loader:done', initNav, { once: true });
  // Sin pantalla de carga (páginas internas) o ya terminada (HMR): anima ya.
  const loaderEl = document.getElementById('loader');
  if (!loaderEl || loaderEl.style.display === 'none') initNav();
</script>
