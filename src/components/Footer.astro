---
const year = new Date().getFullYear();

const links = [
  { href: '/#about', label: 'Sobre mí' },
  { href: '/servicios', label: 'Servicios' },
  // Sección Proyectos: pendiente de añadir casos reales, reactivar cuando tenga
  // proyectos aprobados por el cliente para mostrar.
  // { href: '/proyectos', label: 'Proyectos' },
  { href: '/#contact', label: 'Contacto' },
  { href: '/privacidad', label: 'Privacidad' },
];

// Solo se muestran los perfiles reales. Para añadir LinkedIn o X más adelante,
// descomenta su bloque y pon la URL de tu perfil — sin marcadores de posición.
const socials = [
  {
    name: 'GitHub',
    href: 'https://github.com/mariorivzz',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>`,
  },
  // {
  //   name: 'LinkedIn',
  //   href: 'https://linkedin.com/in/TU-PERFIL-REAL',
  //   icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  // },
  // {
  //   name: 'Twitter / X',
  //   href: 'https://x.com/TU-PERFIL-REAL',
  //   icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  // },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <!-- Brand -->
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Inicio">
          <span class="footer__logo-sym">&lt;</span>dev<span class="footer__logo-sym">/&gt;</span>
        </a>
        <p class="footer__tagline">
          Desarrollador web para negocios locales.<br />
          Construyendo la web que tu competencia no se atreve a lanzar.
        </p>
      </div>

      <!-- Nav -->
      <nav class="footer__nav" aria-label="Footer navigation">
        <span class="footer__nav-title">Navegación</span>
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Socials -->
      <div class="footer__socials-wrap">
        {
          socials.length > 0 && (
            <>
              <span class="footer__nav-title">Redes</span>
              <div class="footer__socials">
                {socials.map((s) => (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer__social-link"
                    aria-label={s.name}
                    set:html={s.icon}
                  />
                ))}
              </div>
            </>
          )
        }
        <a href="/#contact" class="btn btn-outline footer__cta">Empecemos →</a>
      </div>
    </div>

    <!-- Bottom -->
    <div class="footer__bottom">
      <p class="footer__copy">
        © {year}
        <a href="/">Mario Rivas</a>. Todos los derechos reservados.
      </p>
      <p class="footer__made">Diseño y desarrollo propios</p>
    </div>
  </div>

  <!-- Back to top -->
  <button
    id="back-to-top"
    class="back-to-top"
    aria-label="Volver al inicio"
    title="Volver al inicio"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"><polyline points="18 15 12 9 6 15"></polyline></svg
    >
  </button>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding: var(--space-8) 0 var(--space-4);
    position: relative;
  }

  /* ── Zona superior ─────────────────────────── */
  .footer__top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: clamp(var(--space-4), 4vw, var(--space-8));
    margin-bottom: var(--space-8);
  }

  /* Marca — misma tipografía y color que en la cabecera */
  .footer__logo {
    display: inline-block;
    font-family: var(--font-head);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-2);
    transition: color 0.2s var(--ease);
  }

  .footer__logo:hover {
    color: var(--brand);
  }
  .footer__logo-sym {
    color: var(--brand);
    font-weight: 600;
  }

  .footer__tagline {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 24rem;
  }

  /* ── Navegación ────────────────────────────── */
  .footer__nav-title {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .footer__nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer__nav a {
    font-size: var(--fs-sm);
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }

  .footer__nav a:hover {
    color: var(--brand);
  }

  /* ── Redes ─────────────────────────────────── */
  .footer__socials {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .footer__social-link {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-2);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .footer__social-link:hover {
    color: var(--brand);
    border-color: var(--brand-line);
    background: var(--brand-soft);
  }

  /* ── Zona inferior ─────────────────────────── */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .footer__copy,
  .footer__made {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .footer__copy a {
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }
  .footer__copy a:hover {
    color: var(--brand);
  }

  /* ── Volver arriba ─────────────────────────── */
  .back-to-top {
    position: absolute;
    bottom: var(--space-4);
    right: var(--pad-x);
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    color: var(--text-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      opacity 0.25s var(--ease),
      transform 0.2s var(--ease);
    opacity: 0;
    pointer-events: none;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .back-to-top:hover {
    color: var(--brand);
    border-color: var(--brand-line);
    background: var(--brand-soft);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .back-to-top {
      bottom: var(--space-3);
    }
  }

  @media (max-width: 480px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const btn = document.getElementById('back-to-top')!;
  window.addEventListener(
    'scroll',
    () => {
      btn.classList.toggle('visible', window.scrollY > 600);
    },
    { passive: true }
  );
  btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
