<!-- Loading screen — fades out after assets load -->
<div id="loader" aria-hidden="true">
  <div class="loader-inner">
    <span class="loader-label">Mario Rivas</span>
    <div class="loader-bar-wrap">
      <div class="loader-bar" id="loader-bar"></div>
    </div>
    <span class="loader-count" id="loader-count">0</span>
  </div>
</div>

<style>
  #loader {
    position: fixed;
    inset: 0;
    background: var(--bg);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .loader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: min(320px, 78vw);
  }

  .loader-label {
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .loader-bar-wrap {
    width: 100%;
    height: 2px;
    background: var(--border);
    overflow: hidden;
    border-radius: var(--radius-pill);
  }

  .loader-bar {
    height: 100%;
    width: 0%;
    background: var(--brand);
    border-radius: var(--radius-pill);
    transition: width 0.05s linear;
  }

  .loader-count {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    align-self: flex-end;
  }

  #loader.done {
    pointer-events: none;
  }
</style>

<script>
  import gsap from 'gsap';

  const loader = document.getElementById('loader')!;
  const bar = document.getElementById('loader-bar')!;
  const counter = document.getElementById('loader-count')!;

  let progress = 0;

  const tick = setInterval(() => {
    // Accelerate toward 100% over ~1.4s
    progress += Math.random() * 8 + 3;
    if (progress >= 100) {
      progress = 100;
      clearInterval(tick);
      bar.style.width = '100%';
      counter.textContent = '100';

      // Slide loader off screen then remove — content reveal starts as soon
      // as the slide begins, so it's visible underneath while the loader
      // is still moving away (one continuous reveal, not a second "load").
      setTimeout(() => {
        document.body.dispatchEvent(new CustomEvent('loader:done'));
        gsap.to(loader, {
          yPercent: -100,
          duration: 0.9,
          ease: 'power4.inOut',
          onComplete: () => {
            loader.style.display = 'none';
          },
        });
      }, 300);
      return;
    }
    bar.style.width = progress + '%';
    counter.textContent = Math.floor(progress).toString();
  }, 45);
</script>
