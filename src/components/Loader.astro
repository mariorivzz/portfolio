<!-- Loading screen — fades out after assets load -->
<div id="loader" aria-hidden="true">
  <div class="loader-inner">
    <span class="loader-label">Mario Rivas</span>
    <div class="loader-bar-wrap">
      <div class="loader-bar" id="loader-bar"></div>
    </div>
    <span class="loader-count" id="loader-count">0</span>
  </div>
</div>

<style>
  #loader {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .loader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: min(360px, 80vw);
  }

  .loader-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .loader-bar-wrap {
    width: 100%;
    height: 1px;
    background: rgba(255,255,255,0.1);
    overflow: hidden;
    border-radius: 1px;
  }

  .loader-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #00d4ff, #00ff87);
    border-radius: 1px;
    transition: width 0.05s linear;
  }

  .loader-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: #00d4ff;
    letter-spacing: 0.1em;
    align-self: flex-end;
  }

  #loader.done {
    pointer-events: none;
  }
</style>

<script>
  import gsap from 'gsap';

  const loader  = document.getElementById('loader')!;
  const bar     = document.getElementById('loader-bar')!;
  const counter = document.getElementById('loader-count')!;

  let progress = 0;

  const tick = setInterval(() => {
    // Accelerate toward 100% over ~1.4s
    progress += Math.random() * 8 + 3;
    if (progress >= 100) {
      progress = 100;
      clearInterval(tick);
      bar.style.width = '100%';
      counter.textContent = '100';

      // Slide loader off screen then remove
      setTimeout(() => {
        gsap.to(loader, {
          yPercent: -100,
          duration: 0.9,
          ease: 'power4.inOut',
          onComplete: () => {
            loader.style.display = 'none';
            document.body.dispatchEvent(new CustomEvent('loader:done'));
          },
        });
      }, 300);
      return;
    }
    bar.style.width = progress + '%';
    counter.textContent = Math.floor(progress).toString();
  }, 45);
</script>
