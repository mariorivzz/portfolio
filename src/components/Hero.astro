---
// Hero — full-viewport opening with particle canvas background
---

<section id="hero" class="hero">
  <canvas id="hero-canvas" class="hero__canvas" aria-hidden="true"></canvas>

  <!-- Gradient radial glow -->
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__content">
    <!-- Availability badge -->
    <p class="hero__badge reveal-up">
      <span class="hero__badge-dot"></span>
      Disponible para nuevos proyectos · 2026
    </p>

    <!-- Main headline — each word wrapped for GSAP split -->
    <h1 class="hero__title" aria-label="Diseño web que vende para tu negocio local">
      <span class="hero__line">
        <span class="hero__word-wrap"><span class="hero__word">Diseño web</span></span>
      </span>
      <span class="hero__line hero__line--accent">
        <span class="hero__word-wrap"><span class="hero__word">que vende</span></span>
      </span>
      <span class="hero__line">
        <span class="hero__word-wrap"><span class="hero__word">para tu</span></span>
      </span>
      <span class="hero__line">
        <span class="hero__word-wrap"><span class="hero__word">negocio local</span></span>
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="hero__sub reveal-up">
      Desarrollador experto con 8 años de experiencia. Olvida los tecnicismos;
      hablemos de cómo conseguir más clientes para tu negocio hoy mismo.
    </p>

    <!-- SEO tagline -->
    <p class="hero__seo-tag reveal-up">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Webs que cargan rápido, aparecen en Google y convierten visitas en clientes.
    </p>

    <!-- CTAs -->
    <div class="hero__actions reveal-up">
      <a href="#services" class="btn btn-primary">
        <span>Ver mis servicios</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#contact" class="btn btn-outline">Contrátame</a>
    </div>

    <!-- Scroll indicator -->
    <div class="hero__scroll">
      <span>scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--space-8);
  }

  /* ── Canvas ─────────────────────────────────────── */
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* ── Glow ─────────────────────────────────────── */
  .hero__glow {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 80vw;
    height: 80vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(29,53,87,0.05) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Content ─────────────────────────────────────── */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--text-2);
    border: 1px solid var(--border-strong);
    padding: 0.4375rem var(--space-2);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-4);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .hero__badge-dot {
    width: 7px;
    height: 7px;
    background: var(--support);
    border-radius: var(--radius-pill);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(45,106,79,0.35); }
    50% { box-shadow: 0 0 0 7px rgba(45,106,79,0); }
  }

  /* Title */
  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-display);
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin-bottom: var(--space-3);
  }

  .hero__line { overflow: hidden; }
  .hero__word { display: inline-block; }
  .hero__line--accent .hero__word { color: var(--brand); }

  /* Subtitle */
  .hero__sub {
    font-size: var(--fs-lead);
    color: var(--text-2);
    margin-bottom: var(--space-2);
    line-height: 1.7;
    max-width: 34rem;
  }

  .hero__seo-tag {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--support);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-5);
  }

  .hero__seo-tag svg { flex-shrink: 0; }

  /* Actions */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  /* Scroll indicator */
  .hero__scroll {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__scroll-line {
    width: 56px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--border-strong);
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--brand);
    animation: scanline 2s ease-in-out infinite;
  }

  @keyframes scanline {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  @media (max-width: 768px) {
    .hero__actions .btn { width: 100%; }
    .hero__scroll { display: none; }
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { justify-content: center; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Wait for loader ──────────────────────────────────────────
  function initHero() {
    // Text word reveal
    gsap.from('.hero__word', {
      y: '105%',
      duration: 1,
      stagger: 0.08,
      ease: 'power4.out',
      delay: 0.1,
    });

    gsap.to('.hero__badge', {
      y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.05,
    });

    gsap.to('.hero__sub', {
      y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.5,
    });

    gsap.to('.hero__actions', {
      y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.65,
    });

    gsap.from('.hero__scroll', {
      y: 20, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.8,
    });
  }

  document.body.addEventListener('loader:done', initHero, { once: true });
  // Fallback if loader is already done (e.g. HMR)
  if (document.getElementById('loader')?.style.display === 'none') initHero();

  // ── Particle canvas ──────────────────────────────────────────
  class NeuralCanvas {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: Array<{x:number;y:number;vx:number;vy:number;r:number}>;
    mx: number = -9999;
    my: number = -9999;
    D = 130;
    raf = 0;

    constructor(id: string) {
      this.canvas = document.getElementById(id) as HTMLCanvasElement;
      if (!this.canvas) return;
      this.ctx = this.canvas.getContext('2d')!;
      this.particles = [];
      this.resize();
      this.spawn();
      window.addEventListener('resize', () => { this.resize(); this.spawn(); }, { passive: true });
      this.canvas.addEventListener('mousemove', (e) => {
        const r = this.canvas.getBoundingClientRect();
        this.mx = e.clientX - r.left;
        this.my = e.clientY - r.top;
      });
      this.canvas.addEventListener('mouseleave', () => { this.mx = -9999; this.my = -9999; });
      this.loop();
    }

    resize() {
      this.canvas.width  = this.canvas.offsetWidth;
      this.canvas.height = this.canvas.offsetHeight;
    }

    spawn() {
      const n = Math.max(60, Math.floor((this.canvas.width * this.canvas.height) / 16000));
      this.particles = Array.from({ length: n }, () => ({
        x: Math.random() * this.canvas.width,
        y: Math.random() * this.canvas.height,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.6 + 0.6,
      }));
    }

    loop() {
      const { ctx, canvas, particles, D } = this;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (const p of particles) {
        const dx = p.x - this.mx, dy = p.y - this.my;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 90) {
          p.x += (dx / dist) * 1.8;
          p.y += (dy / dist) * 1.8;
        }
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width)  p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(29,53,87,0.28)';
        ctx.fill();
      }

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const d = Math.sqrt(dx*dx + dy*dy);
          if (d < D) {
            const alpha = (1 - d / D) * 0.13;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(29,53,87,${alpha})`;
            ctx.lineWidth = 0.6;
            ctx.stroke();
          }
        }
      }

      this.raf = requestAnimationFrame(() => this.loop());
    }
  }

  // Sin animación de fondo si el usuario ha pedido movimiento reducido.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new NeuralCanvas('hero-canvas');
  }
</script>
