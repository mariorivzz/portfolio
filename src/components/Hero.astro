---
// Hero — full-viewport opening with particle canvas background
---

<section id="hero" class="hero">
  <div class="hero__grid" aria-hidden="true"></div>

  <!-- Gradient radial glow -->
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__content">
    <!-- Availability badge -->
    <p class="hero__badge reveal-up">
      <span class="hero__badge-dot"></span>
      Disponible para nuevos proyectos · 2026
    </p>

    <!-- Titular en texto corrido: es el navegador quien decide dónde cortar
         y `text-wrap: balance` reparte las líneas de forma pareja.
         Antes venía partido a mano en cuatro <span> apilados, y por eso
         "que vende" se quedaba solo en una línea muy corta. -->
    <h1 class="hero__title">
      Diseño web <span class="hero__accent">que vende</span> para tu negocio local
    </h1>

    <!-- Subtitle -->
    <p class="hero__sub reveal-up">
      Desarrollador experto con 5 años de experiencia. Olvida los tecnicismos;
      hablemos de cómo conseguir más clientes para tu negocio hoy mismo.
    </p>

    <!-- SEO tagline -->
    <p class="hero__seo-tag reveal-up">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Webs que cargan rápido, aparecen en Google y convierten visitas en clientes.
    </p>

    <!-- CTAs -->
    <div class="hero__actions reveal-up">
      <a href="#services" class="btn btn-primary">
        <span>Ver mis servicios</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#contact" class="btn btn-outline">Contrátame</a>
    </div>

    <!-- Scroll indicator -->
    <div class="hero__scroll">
      <span>scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--space-8);
  }

  /* ── Retícula de fondo ──────────────────────────────
     Sustituye al lienzo de partículas animadas. Es CSS puro: cero
     JavaScript, cero coste de CPU y ningún movimiento que distraiga.
     La cuadrícula es de 64px (múltiplo de la escala de 8) y se desvanece
     hacia los bordes con una máscara, para que no se corte en seco. */
  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right,  rgba(29, 53, 87, 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(29, 53, 87, 0.055) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 42%, #000 30%, transparent 78%);
    mask-image: radial-gradient(ellipse 75% 65% at 50% 42%, #000 30%, transparent 78%);
  }

  /* ── Halo suave ─────────────────────────────────── */
  .hero__glow {
    position: absolute;
    top: -25%;
    left: 50%;
    transform: translateX(-50%);
    width: 85vw;
    height: 85vw;
    max-width: 1000px;
    max-height: 1000px;
    background: radial-gradient(circle, rgba(29, 53, 87, 0.05) 0%, transparent 62%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Content ─────────────────────────────────────── */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--text-2);
    border: 1px solid var(--border-strong);
    padding: 0.4375rem var(--space-2);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-4);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .hero__badge-dot {
    width: 7px;
    height: 7px;
    background: var(--support);
    border-radius: var(--radius-pill);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(45,106,79,0.35); }
    50% { box-shadow: 0 0 0 7px rgba(45,106,79,0); }
  }

  /* Titular — sin flex ni saltos forzados, para que el texto fluya y el
     navegador pueda equilibrar las líneas (text-wrap: balance en global.css). */
  .hero__title {
    font-size: var(--fs-display);
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin-bottom: var(--space-3);
    max-width: 22ch;
  }

  .hero__accent { color: var(--brand); }

  /* Subtitle */
  .hero__sub {
    font-size: var(--fs-lead);
    color: var(--text-2);
    margin-bottom: var(--space-2);
    line-height: 1.7;
    max-width: 34rem;
  }

  .hero__seo-tag {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--support);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-5);
  }

  .hero__seo-tag svg { flex-shrink: 0; }

  /* Actions */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  /* Scroll indicator */
  .hero__scroll {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__scroll-line {
    width: 56px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--border-strong);
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--brand);
    animation: scanline 2s ease-in-out infinite;
  }

  @keyframes scanline {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  @media (max-width: 768px) {
    .hero__actions .btn { width: 100%; }
    .hero__scroll { display: none; }
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { justify-content: center; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Wait for loader ──────────────────────────────────────────
  function initHero() {
    // El titular entra de una pieza. Ya no hay líneas fijas que enmascarar,
    // y con `from` el estado final es el natural: si el JS fallara, el
    // titular se vería igualmente.
    gsap.from('.hero__title', {
      y: 24,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      delay: 0.1,
    });

    gsap.to('.hero__badge', {
      y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.05,
    });

    gsap.to('.hero__sub', {
      y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.5,
    });

    gsap.to('.hero__actions', {
      y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', delay: 0.65,
    });

    gsap.from('.hero__scroll', {
      y: 20, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.8,
    });
  }

  document.body.addEventListener('loader:done', initHero, { once: true });
  // Fallback if loader is already done (e.g. HMR)
  if (document.getElementById('loader')?.style.display === 'none') initHero();

</script>
