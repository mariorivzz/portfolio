---
// Iconos vectoriales en lugar de emoticonos: mismo golpe de vista, aspecto
// más sobrio y coherente con el resto de iconografía de la web.
const pillars = [
  {
    icon: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    text: 'Webs que cargan al instante, y eso ayuda a salir antes en Google',
  },
  {
    icon: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    text: 'Estrategia diseñada para conseguir clientes',
  },
  {
    icon: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
    text: 'Trato humano y cercano, siempre disponible',
  },
];

const stats = [
  { number: 8,   suffix: '+', label: 'Años de experiencia' },
  { number: 50,  suffix: '+', label: 'Proyectos entregados' },
  { number: 30,  suffix: '+', label: 'Clientes satisfechos' },
  { number: 100, suffix: '%', label: 'Compromiso total'     },
];
---

<section id="about" class="about">
  <div class="container">

    <div class="about__grid">
      <!-- Stats column -->
      <div class="about__stats">
        {stats.map(s => (
          <div class="about__stat reveal-up">
            <span class="about__stat-num" data-target={s.number}>{s.number}</span>
            <span class="about__stat-suf">{s.suffix}</span>
            <span class="about__stat-label">{s.label}</span>
          </div>
        ))}
      </div>

      <!-- Text column -->
      <div class="about__copy">
        <span class="section-tag reveal-up">Sobre mí</span>

        <h2 class="about__heading reveal-up">
          Hola, soy Mario.<br />
          <em>Tu socio de confianza para todo lo digital.</em>
        </h2>

        <div class="about__body">
          <p class="reveal-up">
            En 5 años y más de 50 proyectos exitosos, he aprendido lo que realmente importa:
            <strong>tu negocio</strong>. No buscas solo una web ‘bonita’, buscas una web que
            funcione. Como desarrollador solo, te ofrezco la comunicación directa, la honestidad
            y la transparencia que tu negocio local necesita, sin intermediarios ni costes ocultos.
          </p>
        </div>

        <!-- Differentiators -->
        <p class="about__pillars-title">Resultados que avalan mi compromiso</p>
        <ul class="about__pillars">
          {pillars.map(p => (
            <li class="reveal-up">
              <span class="about__pillar-icon" set:html={p.icon} />
              {p.text}
            </li>
          ))}
        </ul>

        <a href="#contact" class="btn btn-primary reveal-up">
          <span>Hablemos de tu proyecto</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .about {
    padding: var(--section-py) 0;
    border-top: 1px solid var(--border);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(var(--space-6), 6vw, var(--space-12));
    align-items: start;
  }

  /* ── Cifras ─────────────────────────────────── */
  .about__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    position: sticky;
    top: var(--space-12);
  }

  .about__stat {
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .about__stat:hover {
    border-color: var(--brand-line);
    box-shadow: var(--shadow-md);
  }

  .about__stat-num {
    display: inline-block;
    font-family: var(--font-head);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--brand);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .about__stat-suf {
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 600;
    color: var(--brand);
    margin-left: -0.06em;
  }

  .about__stat-label {
    display: block;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin-top: var(--space-1);
    line-height: 1.4;
  }

  /* ── Texto ─────────────────────────────────── */
  .about__heading {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-3);
  }

  .about__heading em {
    font-style: normal;
    color: var(--brand);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.75;
  }

  .about__pillars-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .about__pillars {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .about__pillars li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .about__pillar-icon {
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand);
    background: var(--brand-soft);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__stats { position: static; grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Scroll reveals ───────────────────────────────────────────
  gsap.utils.toArray<HTMLElement>('#about .reveal-up').forEach(el => {
    gsap.to(el, {
      y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 88%', once: true },
    });
  });

  // ── Counter animation ───────────────────────────────────────
  // El número final ya viene escrito en el HTML, así que se ve correcto
  // aunque no haya JS, la conexión sea lenta o falle la carga de GSAP.
  // El JS solo AÑADE el efecto de cuenta atrás cuando procede animar.
  const counters = document.querySelectorAll<HTMLElement>('.about__stat-num');
  const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Con movimiento reducido (o sin IntersectionObserver) no se toca nada:
  // el valor real ya está en pantalla.
  if (!noMotion && 'IntersectionObserver' in window) {
    const countUp = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      if (!target) return;

      // Se pone a 0 justo al empezar a animar, nunca antes: así el número
      // nunca se queda visible en 0 si la animación no llega a arrancar.
      el.textContent = '0';

      gsap.to({ val: 0 }, {
        val: target,
        duration: 1.8,
        ease: 'power2.out',
        onUpdate() { el.textContent = Math.round((this as { targets: () => Array<{ val: number }> }).targets()[0].val).toString(); },
        // Red de seguridad: pase lo que pase, acaba en el valor real.
        onComplete()  { el.textContent = target.toString(); },
        onInterrupt() { el.textContent = target.toString(); },
      });
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        io.unobserve(entry.target);
        countUp(entry.target as HTMLElement);
      });
    }, { threshold: 0.4 });

    counters.forEach(el => io.observe(el));
  }
</script>
