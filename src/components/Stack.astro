---
const techs = [
  { name: 'PHP',           emoji: '🐘' },
  { name: 'JavaScript',    emoji: '⚡' },
  { name: 'MySQL',         emoji: '🗄️' },
  { name: 'SASS / SCSS',   emoji: '🎨' },
  { name: 'HTML5',         emoji: '🌐' },
  { name: 'CSS3',          emoji: '🖌️' },
  { name: 'REST API',      emoji: '🔗' },
  { name: 'Git',           emoji: '🔀' },
  { name: 'Node.js',       emoji: '💚' },
  { name: 'WordPress',     emoji: '📝' },
  { name: 'Responsive',    emoji: '📱' },
  { name: 'SEO',           emoji: '🚀' },
  { name: 'UI / UX',       emoji: '🎯' },
  { name: 'Performance',   emoji: '⚙️' },
];
---

<section id="stack" class="stack">
  <div class="container">
    <div class="stack__header reveal-up">
      <span class="section-tag">Tecnologías</span>
      <h2 class="stack__heading">TECH STACK</h2>
    </div>
  </div>

  <!-- Infinite marquee row 1 (left to right) -->
  <div class="marquee-wrapper" aria-hidden="true">
    <div class="marquee marquee--fwd">
      {[...techs, ...techs].map(t => (
        <span class="tech-badge">
          <span class="tech-badge__emoji">{t.emoji}</span>
          {t.name}
        </span>
      ))}
    </div>
  </div>

  <!-- Infinite marquee row 2 (right to left, offset) -->
  <div class="marquee-wrapper" aria-hidden="true">
    <div class="marquee marquee--rev">
      {[...techs.slice(5), ...techs, ...techs.slice(0, 5)].map(t => (
        <span class="tech-badge tech-badge--alt">
          <span class="tech-badge__emoji">{t.emoji}</span>
          {t.name}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .stack {
    padding: var(--section-py) 0;
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  .stack__header {
    margin-bottom: 4rem;
  }

  .stack__heading {
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.04em;
  }

  /* ── Marquee ────────────────────────────────────────── */
  .marquee-wrapper {
    position: relative;
    display: flex;
    overflow: hidden;
    margin-bottom: 1rem;
    /* fade edges */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
  }

  .marquee {
    display: flex;
    flex-shrink: 0;
    gap: 1rem;
    padding-right: 1rem;
    will-change: transform;
  }

  .marquee--fwd {
    animation: marquee-fwd 28s linear infinite;
  }

  .marquee--rev {
    animation: marquee-rev 32s linear infinite;
  }

  @keyframes marquee-fwd {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @keyframes marquee-rev {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  /* Pause on hover */
  .marquee-wrapper:hover .marquee { animation-play-state: paused; }

  /* ── Badge ──────────────────────────────────────────── */
  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 50px;
    background: var(--bg-card);
    color: var(--text-2);
    cursor: default;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
    user-select: none;
  }

  .tech-badge:hover {
    border-color: var(--border-accent);
    color: var(--accent);
    background: var(--accent-dim);
  }

  .tech-badge--alt {
    border-color: rgba(255,107,53,0.12);
    color: var(--text-muted);
  }

  .tech-badge--alt:hover {
    border-color: rgba(255,107,53,0.4);
    color: var(--warm);
    background: var(--warm-dim);
  }

  .tech-badge__emoji {
    font-size: 1rem;
    line-height: 1;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('#stack .reveal-up').forEach(el => {
    gsap.from(el, {
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 88%', once: true },
    });
  });
</script>
