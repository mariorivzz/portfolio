---
const WA_NUMBER  = '34636495506';
const WA_MESSAGE = encodeURIComponent('Hola Mario, he visto tu portfolio y me gustaría digitalizar mi negocio. ¿Podemos hablar?');
const WA_LINK    = `https://wa.me/${WA_NUMBER}?text=${WA_MESSAGE}`;
---

<a
  href={WA_LINK}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="Escríbeme por WhatsApp"
  title="Escríbeme por WhatsApp"
>
  <!-- WhatsApp icon -->
  <svg class="wa-float__icon" width="28" height="28" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <path d="M16.003 2.667C8.637 2.667 2.667 8.636 2.667 16c0 2.37.625 4.693 1.813 6.74L2.667 29.333l6.784-1.778A13.29 13.29 0 0016.003 29.333C23.37 29.333 29.333 23.364 29.333 16S23.37 2.667 16.003 2.667zm0 2.4c5.94 0 10.93 4.99 10.93 10.933 0 5.944-4.99 10.934-10.93 10.934a10.9 10.9 0 01-5.572-1.53l-.397-.24-4.027 1.056 1.073-3.916-.262-.413A10.87 10.87 0 015.07 16C5.07 10.057 10.062 5.067 16.003 5.067zm-3.13 5.866c-.213 0-.558.08-.851.4-.292.32-1.12 1.094-1.12 2.666s1.146 3.094 1.306 3.307c.16.213 2.24 3.573 5.493 4.853 2.72 1.08 3.254.867 3.84.813.587-.053 1.893-.773 2.16-1.52.267-.746.267-1.386.187-1.52-.08-.133-.294-.213-.614-.373-.32-.16-1.893-.933-2.186-1.04-.294-.106-.507-.16-.72.16-.214.32-.826 1.04-.999 1.253-.174.214-.347.24-.667.08-.32-.16-1.347-.496-2.566-1.587-.948-.845-1.587-1.893-1.774-2.213-.186-.32-.02-.493.14-.653.143-.143.32-.373.48-.56.16-.186.213-.32.32-.533.106-.214.053-.4-.027-.56-.08-.16-.706-1.746-.982-2.386-.266-.626-.546-.52-.72-.52l-.6-.014z"/>
  </svg>

  <!-- Tooltip label -->
  <span class="wa-float__label">¿Hablamos?</span>

  <!-- Pulse ring -->
  <span class="wa-float__pulse" aria-hidden="true"></span>
</a>

<style>
  .wa-float {
    position: fixed;
    bottom: var(--space-4);
    left: var(--space-4);
    z-index: 900;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.75rem var(--space-2);
    background: var(--support);
    color: #FFFFFF;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-lg);
    transition: background-color 0.2s var(--ease), transform 0.2s var(--ease),
                box-shadow 0.2s var(--ease), padding 0.25s var(--ease);
  }

  .wa-float__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-xs);
    white-space: nowrap;
    transition: max-width 0.3s var(--ease), opacity 0.2s var(--ease);
    max-width: 7.5rem;
    opacity: 1;
  }

  .wa-float.is-collapsed .wa-float__label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
  }

  /* Sin el gap, el botón queda un circulo exacto al colapsarse */
  .wa-float.is-collapsed { padding: 0.875rem; border-radius: var(--radius-pill); gap: 0; }

  .wa-float:hover {
    background: #245840;
    transform: translateY(-2px);
  }

  .wa-float__pulse { display: none; }

  @media (max-width: 560px) {
    .wa-float { bottom: var(--space-2); left: var(--space-2); }
  }
</style>

<script>
  // Collapse to icon-only after scrolling 300px, expand back near top
  const btn = document.querySelector('.wa-float') as HTMLElement;
  let collapsed = false;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 300 && !collapsed) {
      btn.classList.add('is-collapsed');
      collapsed = true;
    } else if (window.scrollY <= 300 && collapsed) {
      btn.classList.remove('is-collapsed');
      collapsed = false;
    }
  }, { passive: true });
</script>
