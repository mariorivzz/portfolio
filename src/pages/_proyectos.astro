---
// ⚠️ PÁGINA DESACTIVADA — Sección Proyectos: pendiente de añadir casos reales,
// reactivar cuando tenga proyectos aprobados por el cliente para mostrar.
//
// El guion bajo del nombre (_proyectos.astro) es el mecanismo de Astro para
// excluir un fichero del enrutado: el contenido sigue intacto, pero la URL
// /proyectos no existe y tampoco aparece en el sitemap. Así no se indexa en
// Google una página con proyectos que todavía no puedes enseñar.
//
// PARA REACTIVARLA: quita el guion bajo del nombre del fichero y descomenta
// los enlaces en Nav.astro, Footer.astro y el <Showcase teaser /> de index.astro.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Showcase from '../components/Showcase.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout
  title="Proyectos — Mario Rivas | Webs reales para negocios locales"
  description="Trabajos reales: páginas de una sola sección, webs con asistente que atiende a los clientes, agendas de citas conectadas y renovaciones de webs antiguas."
>
  <Nav />
  <main>
    <Showcase />
  </main>
  <Footer />
  <ChatWidget />
  <WhatsAppFloat />
</Layout>
