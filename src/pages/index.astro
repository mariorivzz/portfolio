---
import Layout     from '../layouts/Layout.astro';
import Loader     from '../components/Loader.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import About      from '../components/About.astro';
import Services   from '../components/Services.astro';
import Showcase   from '../components/Showcase.astro';
import Contact    from '../components/Contact.astro';
import Footer     from '../components/Footer.astro';
import ChatWidget    from '../components/ChatWidget.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout
  title="Mario Rivas — Diseño web para negocios locales | Webs que consiguen clientes"
  description="Desarrollador web con 8 años de experiencia. Webs claras y rápidas para negocios locales, con asistente que atiende a tus clientes a cualquier hora. Desde 450 €."
>
  <Loader />
  <Nav />
  <main>
    <Hero />
    <About />
    <!-- Resumen: 3 planes y 3 proyectos. El listado completo vive en
         /servicios y /proyectos, para no cargar aquí todo de golpe. -->
    <Services teaser />
    <Showcase teaser />
    <Contact />
  </main>
  <Footer />
  <ChatWidget />
  <WhatsAppFloat />
</Layout>
