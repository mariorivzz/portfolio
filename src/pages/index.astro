---
import Layout     from '../layouts/Layout.astro';
import Loader     from '../components/Loader.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import About      from '../components/About.astro';
import Services   from '../components/Services.astro';
// Sección Proyectos: pendiente de añadir casos reales, reactivar cuando tenga
// proyectos aprobados por el cliente para mostrar.
// import Showcase   from '../components/Showcase.astro';
import Contact    from '../components/Contact.astro';
import Footer     from '../components/Footer.astro';
import ChatWidget    from '../components/ChatWidget.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout
  title="Mario Rivas — Diseño web para negocios locales | Webs que consiguen clientes"
  description="Diseño y desarrollo de páginas web en Salamanca: 5 años de experiencia. Webs claras, rápidas y que generan clientes para negocios locales, con asistente que atiende a tus clientes a cualquier hora. Desde 450 €."
>
  <Loader />
  <Nav />
  <main>
    <Hero />
    <About />
    <!-- Resumen de 3 servicios; el listado completo vive en /servicios,
         para no cargar aquí todo de golpe. -->
    <Services teaser />
    <!-- Sección Proyectos: pendiente de añadir casos reales, reactivar cuando
         tenga proyectos aprobados por el cliente para mostrar.
         Para reactivarla: descomentar el import de arriba, esta línea, el
         enlace en Nav.astro y en Footer.astro, y renombrar la página
         src/pages/_proyectos.astro quitándole el guion bajo del principio. -->
    <!-- <Showcase teaser /> -->
    <Contact />
  </main>
  <Footer />
  <ChatWidget />
  <WhatsAppFloat />
</Layout>
