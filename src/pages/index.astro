---
import Layout     from '../layouts/Layout.astro';
import Loader     from '../components/Loader.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import About      from '../components/About.astro';
import Stack      from '../components/Stack.astro';
import Services   from '../components/Services.astro';
import Showcase   from '../components/Showcase.astro';
import Contact    from '../components/Contact.astro';
import Footer     from '../components/Footer.astro';
import ChatWidget    from '../components/ChatWidget.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout
  title="Mario Rivas — Full-Stack Developer · PHP · JavaScript · MySQL"
  description="Full-Stack Developer con 8 años de experiencia. Diseño y desarrollo de landing pages, aplicaciones web y consultoría digital que genera resultados reales."
>
  <Loader />
  <Nav />
  <main>
    <Hero />
    <About />
    <Stack />
    <Services />
    <Showcase />
    <Contact />
  </main>
  <Footer />
  <ChatWidget />
  <WhatsAppFloat />
</Layout>
