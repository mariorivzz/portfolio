---
import Layout         from '../layouts/Layout.astro';
import Nav            from '../components/Nav.astro';
import Showcase       from '../components/Showcase.astro';
import Footer         from '../components/Footer.astro';
import ChatWidget     from '../components/ChatWidget.astro';
import WhatsAppFloat  from '../components/WhatsAppFloat.astro';
---

<Layout
  title="Proyectos — Mario Rivas | Webs reales para negocios locales"
  description="Trabajos reales: páginas de una sola sección, webs con asistente que atiende a los clientes, agendas de citas conectadas y renovaciones de webs antiguas."
>
  <Nav />
  <main>
    <Showcase />
  </main>
  <Footer />
  <ChatWidget />
  <WhatsAppFloat />
</Layout>
