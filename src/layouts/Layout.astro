---
// Fuentes autoalojadas con @fontsource (patrón recomendado por Astro).
// Se sirven desde el propio dominio: sin petición a Google, sin parpadeo y
// sin salto de maquetación al cargar.
import '@fontsource-variable/space-grotesk';  // titulares (600–700)
import '@fontsource-variable/inter';          // cuerpo (400–600)
import '@fontsource/ibm-plex-mono/400.css';   // etiquetas y precios
import '@fontsource/ibm-plex-mono/500.css';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = 'Mario Rivas — Diseño Web para Negocios Locales',
  description = 'Diseñador y desarrollador web con 8 años de experiencia. Webs profesionales para negocios locales que generan clientes de verdad, sin complicaciones ni tecnicismos.',
  robots = 'index, follow',
} = Astro.props;

const siteUrl = 'https://portfolio-mariorivas.vercel.app';
const ogImage = `${siteUrl}/og-image.png`;
const canonicalUrl = Astro.url ? new URL(Astro.url.pathname, siteUrl).href : siteUrl;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mario Rivas" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Verification -->
    <meta name="google-site-verification" content="VGGV2PFjqPYor4HjA-QI69avVE3NvBfDgqi8wkLmgc8" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Mario Rivas — Diseño Web" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data: Person + LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${siteUrl}/#person`,
          "name": "Mario Rivas",
          "url": siteUrl,
          "jobTitle": "Desarrollador Web Freelance",
          "description": description,
          "knowsAbout": ["Diseño Web", "PHP", "JavaScript", "MySQL", "SEO", "WordPress"],
          "sameAs": [
            "https://github.com/mariorivzz"
          ]
        },
        {
          "@type": "ProfessionalService",
          "@id": `${siteUrl}/#business`,
          "name": "Mario Rivas — Diseño Web",
          "url": siteUrl,
          "description": "Servicio de diseño y desarrollo web para negocios locales. Páginas web profesionales que generan clientes reales.",
          "founder": { "@id": `${siteUrl}/#person` },
          "areaServed": {
            "@type": "Country",
            "name": "España"
          },
          "priceRange": "€€",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Servicios de Diseño Web",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Landing Page" },
                "price": "450",
                "priceCurrency": "EUR"
              },
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Web Corporativa" },
                "price": "750",
                "priceCurrency": "EUR"
              },
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Web con Asistente de IA" },
                "price": "997",
                "priceCurrency": "EUR"
              },
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Añade IA a tu Web Actual" },
                "price": "400",
                "priceCurrency": "EUR"
              },
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Mantenimiento Mensual" },
                "price": "197",
                "priceCurrency": "EUR"
              }
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "Mario Rivas — Diseño Web",
          "publisher": { "@id": `${siteUrl}/#person` },
          "inLanguage": "es-ES"
        }
      ]
    })} />

    <!-- Color de la barra del navegador en móvil -->
    <meta name="theme-color" content="#FAF9F6" />
  </head>
  <body>
    <!-- Se retiró el cursor personalizado (punto y anillo de color): sustituía
         el puntero del sistema, lo que despista a quien tiene menos soltura con
         el ordenador, y su brillo no encaja con el tono formal de la marca. -->
    <slot />
  </body>
</html>

