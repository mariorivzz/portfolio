---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = 'Mario Rivas — Diseño Web para Negocios Locales | PHP · JavaScript',
  description = 'Diseñador y desarrollador web freelance con 8 años de experiencia. Webs profesionales para negocios locales que generan clientes. PHP, JavaScript, MySQL.',
  robots = 'index, follow',
} = Astro.props;

const siteUrl = 'https://portfolio-mariorivas.vercel.app';
const ogImage = `${siteUrl}/og-image.png`;
const canonicalUrl = Astro.url ? new URL(Astro.url.pathname, siteUrl).href : siteUrl;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mario Rivas" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Verification -->
    <meta name="google-site-verification" content="VGGV2PFjqPYor4HjA-QI69avVE3NvBfDgqi8wkLmgc8" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Mario Rivas — Diseño Web" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data: Person + LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${siteUrl}/#person`,
          "name": "Mario Rivas",
          "url": siteUrl,
          "jobTitle": "Desarrollador Web Freelance",
          "description": description,
          "knowsAbout": ["Diseño Web", "PHP", "JavaScript", "MySQL", "SEO", "WordPress"],
          "sameAs": [
            "https://github.com/mariorivzz"
          ]
        },
        {
          "@type": "ProfessionalService",
          "@id": `${siteUrl}/#business`,
          "name": "Mario Rivas — Diseño Web",
          "url": siteUrl,
          "description": "Servicio de diseño y desarrollo web para negocios locales. Páginas web profesionales que generan clientes reales.",
          "founder": { "@id": `${siteUrl}/#person` },
          "areaServed": {
            "@type": "Country",
            "name": "España"
          },
          "priceRange": "€€",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Servicios de Diseño Web",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Web Corporativa Esencial" },
                "price": "497",
                "priceCurrency": "EUR"
              },
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Nueva Web con Asistente IA" },
                "price": "997",
                "priceCurrency": "EUR"
              }
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "Mario Rivas — Diseño Web",
          "publisher": { "@id": `${siteUrl}/#person` },
          "inLanguage": "es-ES"
        }
      ]
    })} />

    <!-- Preconnect for fonts speed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <!-- Custom cursor -->
    <div id="cursor-dot" aria-hidden="true"></div>
    <div id="cursor-ring" aria-hidden="true"></div>

    <slot />

    <script>
      // ── Custom cursor ──────────────────────────────────────────
      const dot  = document.getElementById('cursor-dot')!;
      const ring = document.getElementById('cursor-ring')!;
      let ringX = 0, ringY = 0;
      let mouseX = 0, mouseY = 0;

      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        dot.style.left = mouseX + 'px';
        dot.style.top  = mouseY + 'px';
      });

      (function lerpRing() {
        ringX += (mouseX - ringX) * 0.12;
        ringY += (mouseY - ringY) * 0.12;
        ring.style.left = ringX + 'px';
        ring.style.top  = ringY + 'px';
        requestAnimationFrame(lerpRing);
      })();

      document.querySelectorAll('a, button, [data-cursor-hover]').forEach((el) => {
        el.addEventListener('mouseenter', () => ring.classList.add('hovered'));
        el.addEventListener('mouseleave', () => ring.classList.remove('hovered'));
      });
    </script>
  </body>
</html>

